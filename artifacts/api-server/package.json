{
  "name": "metricmint-api",
  "version": "1.0.0",
  "private": true,
  "main": "dist/index.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "build": "esbuild src/index.ts --bundle --platform=node --target=node20 --format=cjs --packages=external --outfile=dist/index.js",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "body-parser": "^2.2.2",
    "dotenv": "^16.0.0",
    "drizzle-orm": "^0.44.0",
    "drizzle-zod": "^0.7.0",
    "express": "^5.0.0",
    "postgres": "^3.4.7",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.0.0",
    "esbuild": "^0.19.0"
  }
}
